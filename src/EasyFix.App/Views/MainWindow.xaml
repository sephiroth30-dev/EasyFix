<Window x:Class="EasyFix.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyFix.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="EasyFix"
        Height="640" Width="1000"
        MinHeight="560" MinWidth="860"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <vm:ScreenToVisibilityConverter x:Key="ScreenVis" />
        <vm:EmptyToCollapsedConverter x:Key="EmptyVis" />
        <vm:InverseBooleanConverter x:Key="Invert" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InvertVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Una fila del reporte: franja de color + título + detalle + números medidos. -->
        <DataTemplate x:Key="ReportRowTemplate" DataType="{x:Type vm:ReportRow}">
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="11" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="2" Margin="0,11,0,11">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="crit">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="warn">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="2" Margin="0,10,0,11">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                               FontSize="11.5" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Metrics}" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding Metrics, Converter={StaticResource EmptyVis}}" />
                </StackPanel>

                <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>

        <!-- Un programa de la lista: casilla, nombre, nota y estado. -->
        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type vm:AppChoice}">
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="11" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Style="{StaticResource AppCheckBox}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Margin="0,11,0,0" />

                <StackPanel Grid.Column="2" Margin="0,9,0,10">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}"
                               FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                    <!-- El motivo del fallo, con su código. Sin esto, "Falló" no sirve de nada. -->
                    <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource DangerBrush}"
                               Visibility="{Binding StatusDetail, Converter={StaticResource EmptyVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding Status}" FontFamily="Consolas"
                           FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding Status, Converter={StaticResource EmptyVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="crit">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Barra de título propia ===== -->
            <Grid Grid.Row="0" Height="40" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductName}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{Binding Attribution}" Style="{StaticResource MutedText}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"
                               Visibility="{Binding Attribution, Converter={StaticResource EmptyVis}}" />
                    <!-- La versión va a la vista: un reporte de error sin versión no se puede atar
                         a ningún build. -->
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center" Margin="8,2,0,0"
                               Foreground="{StaticResource TextMutedBrush}" Opacity="0.7" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource ChromeButton}" Click="Minimize_Click"
                            ToolTip="Minimizar" />
                    <Button Content="▢" Style="{StaticResource ChromeButton}" Click="Maximize_Click"
                            ToolTip="Maximizar o restaurar (doble clic en la barra hace lo mismo)" />
                    <Button Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click"
                            ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- ===== Cuerpo: barra lateral de navegación + contenido ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Barra lateral: siempre visible, es el panel de navegación ===== -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="16,18,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Identidad del equipo: una sola vez acá, no repetida en cada pantalla. -->
                        <Border Grid.Row="0" Style="{StaticResource StatusPanel}" Margin="0,0,0,18">
                            <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource MutedText}"
                                       FontSize="11.5" />
                        </Border>

                        <!-- Navegación: las cuatro acciones, siempre a mano. Disponibles se evalúa
                             internamente (ej. "Mejorar" sin analizar antes solo avisa, no rompe). -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <Button Style="{StaticResource SidebarNavButton}" Command="{Binding AnalyzeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Analizar el equipo" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}" Command="{Binding ImproveCommand}"
                                    IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Mejorar rendimiento" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}" Command="{Binding RepairCommand}"
                                    IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Reparar errores" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}" Command="{Binding InstallAppsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Instalar programas" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Acción propia: los drivers son parte de «Reparar errores», pero
                                 esperar los 40 min de DISM para actualizar un driver de red no
                                 tiene sentido. Corre el mismo fix, por el mismo FixRunner, con
                                 las mismas compuertas de seguridad. -->
                            <Button Style="{StaticResource SidebarNavButton}" Command="{Binding UpdateDriversCommand}"
                                    IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}"
                                    ToolTip="Instala solos los controladores de bajo riesgo (red, video, audio, USB, Bluetooth, impresora). Los de almacenamiento se informan sin tocar; el firmware/BIOS nunca.">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Buscar controladores" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Deshacer: solo si hay algo que revertir. Vive siempre abajo del todo,
                             separado de las acciones normales — es la de "algo salió mal". -->
                        <Button Grid.Row="2" Style="{StaticResource SidebarNavButton}"
                                Command="{Binding OpenUndoCommand}"
                                Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}"
                                BorderBrush="{StaticResource WarningBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="16" CornerRadius="2" Margin="0,0,10,0"
                                               VerticalAlignment="Top"
                                               Background="{StaticResource WarningBrush}" />
                                <StackPanel>
                                    <TextBlock Text="Deshacer la última reparación" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding UndoSummary}" Style="{StaticResource MutedText}"
                                               FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Contenido: cambia según la pantalla actual ===== -->
                <Grid Grid.Column="1">

            <!-- ===== 1. Inicio ===== -->
            <Grid Margin="28,24,28,24"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Home}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Estado vacío: las acciones viven en la barra lateral, no se repiten acá. -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="360">
                    <TextBlock Text="Elegí una acción en el panel izquierdo para empezar"
                               Style="{StaticResource TitleText}" FontSize="15"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="«Analizar» es de solo lectura y no modifica nada. Es el primer paso en cualquier equipo nuevo."
                               Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"
                               TextAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource StatusPanel}"
                        Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" FontSize="11.5" />
                </Border>
            </Grid>

            <!-- ===== 2. Analizando ===== -->
            <StackPanel Margin="28,24,28,24" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="460"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Scanning}">
                <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource TitleText}"
                           FontSize="15" Margin="0,4,0,14" />

                <!-- Progreso: paso, porcentaje, barra y detalle. -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ProgressStep}"
                               Style="{StaticResource MutedText}" FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding ProgressStep, Converter={StaticResource EmptyVis}}" />

                    <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercentText}"
                               Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                               Visibility="{Binding ProgressIsIndeterminate, Converter={StaticResource InvertVis}}" />
                </Grid>

                <ProgressBar Style="{StaticResource ProgressBarStyle}"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate}" />

                <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource MutedText}"
                           FontSize="11.5" Margin="0,8,0,0"
                           Visibility="{Binding ProgressDetail, Converter={StaticResource EmptyVis}}" />

                <Border Style="{StaticResource StatusPanel}" Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5"
                               Text="Nada de esto modifica el equipo. Si alguna comprobación tarda demasiado, se salta y el informe sale igual." />
                </Border>

                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,16,0,0"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 3. Reporte — dos columnas: lo cramped que quedaba en una sola pantalla
                 angosta era justamente el problema a resolver con más ancho. ===== -->
            <Grid Margin="28,24,28,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Report}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda: lo que se mide y lo que se puede arreglar sin comprar nada. -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="ESTADO DEL EQUIPO" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding HasChecklistRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding ChecklistRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />

                            <TextBlock Text="LO QUE PUEDO ARREGLAR" Style="{StaticResource SectionHeader}"
                                       Visibility="{Binding HasSoftwareRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding SoftwareRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Columna derecha: lo que necesita comprar algo, y lo que no se pudo medir. -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="LO QUE NECESITA HARDWARE" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding HasHardwareRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding HardwareRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />

                            <TextBlock Text="NO SE PUDO DETERMINAR" Style="{StaticResource SectionHeader}"
                                       Visibility="{Binding HasUndeterminedRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding UndeterminedRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />

                            <Border Style="{StaticResource StatusPanel}"
                                    Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                           FontSize="11.5" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <!-- La confirmación de BitLocker solo aparece si el equipo lo tiene activo.
                         Sin marcarla, las reparaciones que tocan arranque o disco quedan
                         bloqueadas: es la única consecuencia irreversible que puede causar la
                         herramienta. -->
                    <Border Style="{StaticResource StatusPanel}" Margin="0,0,0,10"
                            BorderBrush="{StaticResource DangerBrush}"
                            Visibility="{Binding BitLockerActive, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Este equipo tiene BitLocker" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,8"
                                       Text="Reparar el disco o la red puede hacer que Windows pida la clave de recuperación de 48 dígitos al reiniciar. Sin esa clave, el cliente queda fuera de su propio equipo." />
                            <CheckBox Style="{StaticResource LabeledCheckBox}"
                                      IsChecked="{Binding BitLockerKeyConfirmed, Mode=TwoWay}">
                                <TextBlock Text="Confirmo que la clave de recuperación está a mano"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Continuar sin punto de restauración: decisión explícita del técnico, nunca
                         el default. En muchos equipos Restaurar sistema viene deshabilitado y
                         bloquear todo dejaba la herramienta inservible. -->
                    <Border Style="{StaticResource StatusPanel}" Margin="0,0,0,10"
                            BorderBrush="{StaticResource WarningBrush}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource LabeledCheckBox}"
                                      IsChecked="{Binding AllowWithoutRestorePoint, Mode=TwoWay}">
                                <TextBlock Text="Continuar aunque no se pueda crear el punto de restauración"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="10.5" Margin="25,5,0,0"
                                       Text="Cada cambio queda registrado igual, así que «Deshacer todo» sigue funcionando. Lo que se pierde es el respaldo del sistema completo." />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Volver" Command="{Binding BackCommand}"
                                Style="{StaticResource GhostButton}" Width="100" />
                        <Button Content="Mejorar" Command="{Binding ImproveCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}" />
                        <Button Content="Reparar" Command="{Binding RepairCommand}"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ===== 4. Instalar programas ===== -->
            <Grid Margin="28,24,28,24"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Apps}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="620" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Margin="0,4,0,10">
                    <TextBlock Text="Instalar programas" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0"
                               Text="Se descargan del repositorio oficial de Microsoft en el momento, así que siempre entra la última versión. El equipo necesita internet." />
                </StackPanel>

                <!-- Solo la LISTA scrollea. El progreso vive abajo, fijo: antes estaba acá
                     adentro y con varios programas marcados había que scrollear para ver la barra
                     — justo lo que uno mira mientras espera. La lista queda habilitada durante la
                     instalación: marcar algo lo suma a la tanda en curso. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <ItemsControl ItemsSource="{Binding Apps}"
                                  ItemTemplate="{StaticResource AppRowTemplate}" />
                </ScrollViewer>

                <!-- Panel de progreso fijo. Incluye la historia del programa en curso: una
                     instalación de varios minutos con una barra quieta se siente eterna, y deja
                     al técnico sin nada que contarle al cliente que está mirando. -->
                <Border Grid.Row="2" Style="{StaticResource StatusPanel}" Margin="0,12,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding InstallProgressLabel}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercentText}"
                                       Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                                       Visibility="{Binding ProgressIsIndeterminate, Converter={StaticResource InvertVis}}" />
                        </Grid>

                        <ProgressBar Style="{StaticResource ProgressBarStyle}"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding ProgressIsIndeterminate}" />

                        <TextBlock Text="{Binding ProgressStep}" Style="{StaticResource MutedText}"
                                   FontSize="11" Margin="0,8,0,0"
                                   Visibility="{Binding ProgressStep, Converter={StaticResource EmptyVis}}" />

                        <!-- La historia del programa que se está instalando. -->
                        <TextBlock Text="{Binding CurrentStory}" Style="{StaticResource MutedText}"
                                   FontSize="12" Margin="0,10,0,0" LineHeight="18"
                                   Visibility="{Binding CurrentStory, Converter={StaticResource EmptyVis}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource StatusPanel}"
                        Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                               FontSize="11.5" TextWrapping="Wrap" />
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Volver" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}" Width="80"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                    <Button Content="Diagnosticar winget" Command="{Binding DiagnoseWingetCommand}"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            ToolTip="Si falta winget, «Instalar» ya intenta ponerlo solo. Usá esto si después de instalar algo sigue sin andar y querés ver el detalle técnico."
                            Visibility="{Binding IsBusy, Converter={StaticResource InvertVis}}" />

                    <!-- Durante la instalación, «Instalar» se reemplaza por «Cancelar»: antes no
                         había forma de salir de una tanda larga salvo matar la app. -->
                    <Button Content="Instalar" Command="{Binding RunInstallCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource InvertVis}}" />
                    <Button Content="Cancelar" Command="{Binding CancelCommand}"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            ToolTip="Corta la tanda. El programa que ya se esté instalando termina igual."
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />

                    <!-- Después de instalar: atajo a la pantalla de Windows donde se eligen el
                         navegador y el lector de PDF predeterminados. Windows NO permite que un
                         programa los cambie solo (driver UCPD + hash por usuario); esto abre el
                         lugar exacto para hacerlo en dos clics. -->
                    <Button Content="Predeterminados" Command="{Binding OpenDefaultAppsCommand}"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            ToolTip="Abre la pantalla de Windows para poner Chrome como navegador y Acrobat Reader para los PDF."
                            Visibility="{Binding IsBusy, Converter={StaticResource InvertVis}}" />
                </StackPanel>
            </Grid>

            <!-- ===== 5. Reparando ===== -->
            <StackPanel Margin="28,24,28,24" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="460"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Repairing}">
                <TextBlock Text="{Binding RunningCategoryLabel}" Style="{StaticResource TitleText}"
                           FontSize="15" Margin="0,4,0,4" />
                <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}"
                           FontSize="12.5" Margin="0,0,0,16" />

                <!-- Progreso: título, porcentaje, barra y detalle. -->
                <StackPanel Margin="0,0,0,4">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding ProgressStep}"
                                   Style="{StaticResource MutedText}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ProgressStep, Converter={StaticResource EmptyVis}}" />

                        <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercentText}"
                                   Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                                   Visibility="{Binding ProgressIsIndeterminate, Converter={StaticResource InvertVis}}" />
                    </Grid>

                    <ProgressBar Style="{StaticResource ProgressBarStyle}"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressIsIndeterminate}" />

                    <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource MutedText}"
                               FontSize="11.5" Margin="0,8,0,0"
                               Visibility="{Binding ProgressDetail, Converter={StaticResource EmptyVis}}" />
                </StackPanel>

                <Border Style="{StaticResource StatusPanel}">
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5"
                               Text="Podés cerrar esta ventana sin miedo: cada cambio queda registrado antes de aplicarse y se puede deshacer después. Reparar los archivos del sistema puede tardar hasta 40 minutos." />
                </Border>

                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,16,0,0"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 6. Resultado de la reparación — dos columnas ===== -->
            <Grid Margin="28,24,28,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=RepairResult}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Resultado de la reparación"
                           Style="{StaticResource TitleText}" FontSize="15" Margin="0,4,0,10" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda: la prueba de que funcionó — cada condición, antes y después. -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="ESTADO DEL EQUIPO — ANTES Y DESPUÉS"
                                       Style="{StaticResource SectionHeader}" Margin="0,0,0,4"
                                       Visibility="{Binding HasChecklistCompareRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding ChecklistCompareRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Columna derecha: lo que se hizo, paso por paso, y los avisos. -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="LO QUE SE HIZO" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding HasRepairRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding RepairRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />

                            <Border Style="{StaticResource StatusPanel}"
                                    Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                           FontSize="11.5" />
                            </Border>

                            <Border Style="{StaticResource StatusPanel}"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    Visibility="{Binding RebootRequired, Converter={StaticResource BoolVis}}">
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11.5"
                                           Text="Hay cambios que necesitan reinicio para tener efecto. Reiniciá el equipo y volvé a analizar: el tiempo de arranque se compara contra el valor de antes." />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Button Grid.Row="2" Content="Volver al inicio" Command="{Binding BackCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,14,0,0" HorizontalAlignment="Left" />
            </Grid>

            <!-- ===== 7. Deshacer ===== -->
            <Grid Margin="28,24,28,24"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Undo}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="600" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Margin="0,4,0,10">
                    <TextBlock Text="Deshacer la última reparación"
                               Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0"
                               Text="Esto es lo que se va a revertir. Deshacer también modifica el equipo, así que revisá la lista antes de aplicarlo." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding UndoRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}" />

                        <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}"
                                   FontSize="11.5" Margin="0,14,0,0"
                                   Visibility="{Binding ProgressLabel, Converter={StaticResource EmptyVis}}" />

                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProgressStep}"
                                           Style="{StaticResource MutedText}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercentText}"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                                           Visibility="{Binding ProgressIsIndeterminate, Converter={StaticResource InvertVis}}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource ProgressBarStyle}"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding ProgressIsIndeterminate}" />
                        </StackPanel>

                        <Border Style="{StaticResource StatusPanel}"
                                Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                       FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Volver" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}" Width="100"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                    <Button Content="Deshacer todo" Command="{Binding UndoCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
