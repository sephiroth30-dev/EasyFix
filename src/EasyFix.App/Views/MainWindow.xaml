<Window x:Class="EasyFix.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyFix.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="EasyFix"
        Height="640" Width="1000"
        MinHeight="560" MinWidth="860"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <vm:ScreenToVisibilityConverter x:Key="ScreenVis" />
        <vm:EmptyToCollapsedConverter x:Key="EmptyVis" />
        <vm:InverseBooleanConverter x:Key="Invert" />
        <vm:InverseBooleanToVisibilityConverter x:Key="InvertVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <vm:HexToBrushConverter x:Key="HexBrush" />
        <vm:InstallerPathToIconConverter x:Key="InstallerIcon" />
        <vm:NullToTrueConverter x:Key="NullToTrue" />

        <!-- Una fila del reporte.
             Sin la franja de color vertical que había antes a la izquierda: leída de lejos
             parecía un adorno de la herramienta, no información. La gravedad ahora la lleva el
             punto de color junto al título, que está donde el ojo ya está mirando.
             Sin línea divisoria tampoco: el espacio separa igual y suma menos ruido. -->
        <DataTemplate x:Key="ReportRowTemplate" DataType="{x:Type vm:ReportRow}">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,16,11,0"
                         VerticalAlignment="Top">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="crit">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="warn">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="ok">
                                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <StackPanel Grid.Column="1" Margin="0,10,0,12">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                               FontSize="11.5" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Metrics}" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding Metrics, Converter={StaticResource EmptyVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Un programa de la lista: casilla, nombre, nota y estado. -->
        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type vm:AppChoice}">
            <Grid Margin="0,0,0,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Lo que el análisis encontró ya instalado se ve atenuado: se distingue de un
                     vistazo sin tener que leer el estado de cada fila. -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAlreadyPresent}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="11" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Style="{StaticResource AppCheckBox}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Margin="0,11,0,0" />

                <StackPanel Grid.Column="2" Margin="0,9,0,10">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}"
                               FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                    <!-- El motivo del fallo, con su código. Sin esto, "Falló" no sirve de nada. -->
                    <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource DangerBrush}"
                               Visibility="{Binding StatusDetail, Converter={StaticResource EmptyVis}}" />
                </StackPanel>

                <!-- Avance de ESTE programa. Una barra global no dice cuál está tardando ni
                     cuánto le falta; en la fila se ve de un vistazo. -->
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,10"
                            Visibility="{Binding IsWorking, Converter={StaticResource BoolVis}}">
                    <ProgressBar Style="{StaticResource ProgressBarStyle}" Height="4"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressDetail, Converter={StaticResource NullToTrue}}" />
                    <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource MutedText}"
                               FontSize="10.5" Margin="0,4,0,0"
                               Visibility="{Binding ProgressDetail, Converter={StaticResource EmptyVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding Status}" FontFamily="Consolas"
                           FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding Status, Converter={StaticResource EmptyVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="crit">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Grid.ColumnSpan="4" Grid.RowSpan="2" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Barra de título propia ===== -->
            <Grid Grid.Row="0" Height="40" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductName}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{Binding Attribution}" Style="{StaticResource MutedText}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"
                               Visibility="{Binding Attribution, Converter={StaticResource EmptyVis}}" />
                    <!-- La versión va a la vista: un reporte de error sin versión no se puede atar
                         a ningún build. -->
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center" Margin="8,2,0,0"
                               Foreground="{StaticResource TextMutedBrush}" Opacity="0.7" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource ChromeButton}" Click="Minimize_Click"
                            ToolTip="Minimizar" />
                    <Button Content="▢" Style="{StaticResource ChromeButton}" Click="Maximize_Click"
                            ToolTip="Maximizar o restaurar (doble clic en la barra hace lo mismo)" />
                    <Button Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click"
                            ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- ===== Cuerpo: sin barra lateral =====
                 La barra de 248px se eliminó entera. Con el análisis corriendo solo al abrir
                 (v0.13.0), «Analizar» quedó como botón vestigial, y a la barra le sobraba espacio
                 vacío ocupando casi un tercio del ancho. El técnico lo pidió así: «el mini resumen
                 central recuperando el espacio de la izquierda».

                 La navegación pasa a ser contextual: UN botón principal —el que corresponde a lo
                 que se encontró— y el resto como enlaces discretos al pie. -->
            <Grid Grid.Row="1">

            <!-- ===== 1. Inicio: el inventario del equipo =====
                 Es la pantalla que se ve al abrir y a la que se vuelve siempre. Muestra SOLO lo
                 que necesita atención; las 12 condiciones completas quedan detrás de «Ver todo».
                 Home y Report comparten esta plantilla: después de v0.13.0 el análisis es
                 automático, así que no hay un «antes de analizar» que valga una pantalla propia. -->
            <Grid Margin="48,16,48,20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="Home">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentScreen}" Value="Report">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Proporcional, no fija: al maximizar, las dos columnas crecen en vez de
                     dejar el espacio extra vacío. El MinWidth evita que la de atención se
                     aplaste en una ventana chica, y el MaxWidth que se estire tanto que las
                     líneas se vuelvan incómodas de leer. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="2*" MinWidth="290" MaxWidth="560" />
                </Grid.ColumnDefinitions>

                <!-- ===== Centro: identidad del equipo, titular y la acción ===== -->
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" MaxWidth="620">
                    <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource MutedText}"
                               FontSize="12.5" TextAlignment="Center" Opacity="0.85" />

                    <TextBlock Text="{Binding Headline}"
                               FontFamily="{StaticResource UiFont}" FontSize="30" FontWeight="Light"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />

                    <!-- UN botón principal, y solo si de verdad hay algo que hacer. Con el disco
                         fallando no aparece ninguno: optimizar un disco que se muere es la peor
                         jugada, y la pantalla respeta la misma compuerta que el motor. -->
                    <Button Content="Mejorar rendimiento" Command="{Binding ImproveCommand}"
                            Style="{StaticResource HeroButton}" Margin="0,28,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowImproveAsPrimary, Converter={StaticResource BoolVis}}" />

                    <Button Content="Reparar errores" Command="{Binding RepairCommand}"
                            Style="{StaticResource LinkButton}" Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding ShowAnySecondaryAction, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <!-- ===== Derecha: solo lo que necesita atención ===== -->
                <Grid Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                      Visibility="{Binding HasAttentionRows, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NECESITA ATENCIÓN"
                               Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  MaxHeight="380" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding AttentionRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}" />
                    </ScrollViewer>

                    <Button Grid.Row="2" Command="{Binding ShowFullReportCommand}"
                            Style="{StaticResource LinkButton}" Margin="0,12,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock>
                            <Run Text="Ver todo (" /><Run Text="{Binding ReviewedCount, Mode=OneWay}" /><Run
                                Text=" revisado, " /><Run Text="{Binding GoodCount, Mode=OneWay}" /><Run Text=" bien)" />
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- ===== Pie: el resto de las acciones, sin competir con la principal ===== -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="Instalar programas" Command="{Binding InstallAppsCommand}"
                            Style="{StaticResource LinkButton}" />
                    <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="12,0" Opacity="0.5" />
                    <Button Content="Buscar controladores" Command="{Binding UpdateDriversCommand}"
                            Style="{StaticResource LinkButton}"
                            IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}" />
                    <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="12,0" Opacity="0.5"
                               Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}" />
                    <Button Content="Deshacer la última reparación" Command="{Binding OpenUndoCommand}"
                            Style="{StaticResource LinkButton}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="12,0" Opacity="0.5" />
                    <Button Content="Volver a analizar" Command="{Binding AnalyzeCommand}"
                            Style="{StaticResource LinkButton}" />
                </StackPanel>
            </Grid>

            <!-- ===== 2. Analizando ===== -->
            <StackPanel Margin="28,24,28,24" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="560"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Scanning}">
                <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource TitleText}"
                           FontSize="15" Margin="0,4,0,14" />

                <!-- Progreso: paso, porcentaje, barra y detalle. -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ProgressStep}"
                               Style="{StaticResource MutedText}" FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding ProgressStep, Converter={StaticResource EmptyVis}}" />

                    <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercentText}"
                               Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                               Visibility="{Binding ProgressIsIndeterminate, Converter={StaticResource InvertVis}}" />
                </Grid>

                <ProgressBar Style="{StaticResource ProgressBarStyle}"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate}" />

                <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource MutedText}"
                           FontSize="11.5" Margin="0,8,0,0"
                           Visibility="{Binding ProgressDetail, Converter={StaticResource EmptyVis}}" />

                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,16,0,0"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 3. Reporte — dos columnas: lo cramped que quedaba en una sola pantalla
                 angosta era justamente el problema a resolver con más ancho. ===== -->
            <Grid Margin="28,24,28,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=FullReport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda: lo que se mide y lo que se puede arreglar sin comprar nada. -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="ESTADO DEL EQUIPO" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding HasChecklistRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding ChecklistRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />

                            <TextBlock Text="LO QUE PUEDO ARREGLAR" Style="{StaticResource SectionHeader}"
                                       Visibility="{Binding HasSoftwareRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding SoftwareRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Columna derecha: lo que necesita comprar algo, y lo que no se pudo medir. -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="LO QUE NECESITA HARDWARE" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding HasHardwareRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding HardwareRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />

                            <TextBlock Text="NO SE PUDO DETERMINAR" Style="{StaticResource SectionHeader}"
                                       Visibility="{Binding HasUndeterminedRows, Converter={StaticResource BoolVis}}" />
                            <ItemsControl ItemsSource="{Binding UndeterminedRows}"
                                          ItemTemplate="{StaticResource ReportRowTemplate}" />

                            <Border Style="{StaticResource StatusPanel}"
                                    Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                           FontSize="11.5" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <!-- La confirmación de BitLocker solo aparece si el equipo lo tiene activo.
                         Sin marcarla, las reparaciones que tocan arranque o disco quedan
                         bloqueadas: es la única consecuencia irreversible que puede causar la
                         herramienta. -->
                    <Border Style="{StaticResource StatusPanel}" Margin="0,0,0,10"
                            BorderBrush="{StaticResource DangerBrush}"
                            Visibility="{Binding BitLockerActive, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Este equipo tiene BitLocker" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,8"
                                       Text="Reparar el disco o la red puede hacer que Windows pida la clave de recuperación de 48 dígitos al reiniciar. Sin esa clave, el cliente queda fuera de su propio equipo." />
                            <CheckBox Style="{StaticResource LabeledCheckBox}"
                                      IsChecked="{Binding BitLockerKeyConfirmed, Mode=TwoWay}">
                                <TextBlock Text="Confirmo que la clave de recuperación está a mano"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Continuar sin punto de restauración: decisión explícita del técnico, nunca
                         el default. En muchos equipos Restaurar sistema viene deshabilitado y
                         bloquear todo dejaba la herramienta inservible. -->
                    <Border Style="{StaticResource StatusPanel}" Margin="0,0,0,10"
                            BorderBrush="{StaticResource WarningBrush}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource LabeledCheckBox}"
                                      IsChecked="{Binding AllowWithoutRestorePoint, Mode=TwoWay}">
                                <TextBlock Text="Continuar aunque no se pueda crear el punto de restauración"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="10.5" Margin="25,5,0,0"
                                       Text="Cada cambio queda registrado igual, así que «Deshacer todo» sigue funcionando. Lo que se pierde es el respaldo del sistema completo." />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Volver" Command="{Binding BackCommand}"
                                Style="{StaticResource GhostButton}" Width="100" />
                        <Button Content="Mejorar" Command="{Binding ImproveCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}" />
                        <Button Content="Reparar" Command="{Binding RepairCommand}"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ===== 4. Instalar programas =====
                 Dos columnas, como las herramientas de este tipo que funcionan bien: a la
                 izquierda el contenido protagonista (antes de instalar: qué va a pasar; durante:
                 LA HISTORIA del programa en curso, grande y legible), a la derecha la lista con
                 el estado de cada uno. El objetivo es que quien mira la pantalla tenga algo que
                 leer y entienda qué está pasando, en vez de una barra muda. -->
            <Grid Margin="36,28,36,28"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Apps}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="480" />
                </Grid.ColumnDefinitions>

                <!-- ===== Columna izquierda: el protagonista ===== -->
                <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">


                    <!-- Durante la instalación: la historia manda. -->
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">

                        <!-- Monograma de la marca: círculo con su color y la inicial. No es el
                             logo real — cuando se cuenta la historia el programa todavía se está
                             instalando, así que no hay ejecutable del que sacar el icono, y
                             empaquetar logos ajenos traería binarios de marcas al repo.
                             Entra con una animación corta para que se note el cambio de programa. -->
                        <!-- El logo REAL del programa, sacado del instalador recién descargado.
                             Si no hay icono (paquetes de winget, o un instalador sin icono) se
                             ve el monograma de abajo. -->
                        <Image Source="{Binding CurrentLogoPath, Converter={StaticResource InstallerIcon}}"
                               Width="72" Height="72" HorizontalAlignment="Left" Margin="0,0,0,22"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding CurrentLogoPath, Converter={StaticResource EmptyVis}}" />

                        <Border Width="68" Height="68" CornerRadius="34"
                                HorizontalAlignment="Left" Margin="0,0,0,22"
                                Background="{Binding CurrentBrandColor, Converter={StaticResource HexBrush}}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentLogoPath}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="MonogramScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>

                            <TextBlock Text="{Binding CurrentBrandInitial}"
                                       FontFamily="{StaticResource UiFont}" FontSize="30"
                                       FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <Border.Triggers>
                                <!-- Se dispara cada vez que el monograma se vuelve visible, o sea
                                     al empezar cada programa de la tanda. -->
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MonogramScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.6" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="MonogramScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.6" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>

                        <TextBlock Text="{Binding CurrentStoryTitle}"
                                   FontFamily="{StaticResource UiFont}" FontSize="34"
                                   FontWeight="Light" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"
                                   Visibility="{Binding CurrentStoryTitle, Converter={StaticResource EmptyVis}}" />

                        <TextBlock Text="{Binding CurrentStory}"
                                   FontFamily="{StaticResource UiFont}" FontSize="15"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" LineHeight="26"
                                   Margin="0,20,0,0" MaxWidth="780"
                                   HorizontalAlignment="Left"
                                   Visibility="{Binding CurrentStory, Converter={StaticResource EmptyVis}}" />

                        <!-- Progreso: fino y discreto, debajo de la historia. No compite con
                             ella, pero está siempre a la vista sin scrollear. -->
                        <StackPanel Margin="0,34,0,0" MaxWidth="780" HorizontalAlignment="Left">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding InstallProgressLabel}"
                                           Style="{StaticResource MutedText}" FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercentText}"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                                           Visibility="{Binding ProgressIsIndeterminate, Converter={StaticResource InvertVis}}" />
                            </Grid>

                            <ProgressBar Style="{StaticResource ProgressBarStyle}"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding ProgressIsIndeterminate}" />

                            <TextBlock Text="{Binding ProgressStep}" Style="{StaticResource MutedText}"
                                       FontSize="11" Margin="0,8,0,0" Opacity="0.8"
                                       Visibility="{Binding ProgressStep, Converter={StaticResource EmptyVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Columna derecha: la lista, con su estado ===== -->
                <Grid Grid.Row="0" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="QUÉ SE VA A INSTALAR"
                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />

                    <!-- Solo la lista scrollea: el progreso vive en la otra columna y no se va
                         de la vista nunca. La lista sigue habilitada durante la instalación —
                         marcar algo lo suma a la tanda en curso. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Apps}"
                                      ItemTemplate="{StaticResource AppRowTemplate}" />
                    </ScrollViewer>
                </Grid>

                <!-- Mensaje de resultado, a lo ancho de las dos columnas. -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource StatusPanel}"
                        Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- DOS botones, no cinco.
                     Antes había Volver, Instalar, Actualizar, Predeterminados y Diagnosticar
                     winget, todos con el mismo peso visual, compitiendo por la atención en el
                     momento en que solo hay una cosa que hacer: instalar. Lo secundario pasó a
                     enlaces discretos a la derecha — sigue a un clic, sin ocupar el lugar de la
                     acción principal. -->
                <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Volver" Command="{Binding BackCommand}"
                                Style="{StaticResource GhostButton}" Width="80"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />

                        <!-- Durante la instalación, «Instalar» se reemplaza por «Cancelar». -->
                        <Button Content="Instalar" Command="{Binding RunInstallCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvertVis}}" />
                        <Button Content="Cancelar" Command="{Binding CancelCommand}"
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                ToolTip="Corta la tanda. El programa que ya se esté instalando termina igual."
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource InvertVis}}">
                        <Button Content="Actualizar lo instalado" Command="{Binding UpgradeInstalledCommand}"
                                Style="{StaticResource LinkButton}"
                                ToolTip="Busca versiones nuevas de los programas que YA están en el equipo. No instala nada que no esté." />
                        <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="10,0" Opacity="0.5" />
                        <Button Content="Predeterminados" Command="{Binding OpenDefaultAppsCommand}"
                                Style="{StaticResource LinkButton}"
                                ToolTip="Abre la pantalla de Windows para elegir el navegador y el lector de PDF." />
                        <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="10,0" Opacity="0.5" />
                        <Button Content="Diagnosticar winget" Command="{Binding DiagnoseWingetCommand}"
                                Style="{StaticResource LinkButton}"
                                ToolTip="Si falta winget, «Instalar» ya intenta ponerlo solo. Usá esto si algo sigue sin andar y querés el detalle técnico." />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== 5. Reparando ===== -->
            <StackPanel Margin="28,24,28,24" VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="560"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Repairing}">
                <TextBlock Text="{Binding RunningCategoryLabel}" Style="{StaticResource TitleText}"
                           FontSize="15" Margin="0,4,0,4" />
                <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}"
                           FontSize="12.5" Margin="0,0,0,16" />

                <!-- Progreso: título, porcentaje, barra y detalle. -->
                <StackPanel Margin="0,0,0,4">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding ProgressStep}"
                                   Style="{StaticResource MutedText}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ProgressStep, Converter={StaticResource EmptyVis}}" />

                        <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercentText}"
                                   Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                                   Visibility="{Binding ProgressIsIndeterminate, Converter={StaticResource InvertVis}}" />
                    </Grid>

                    <ProgressBar Style="{StaticResource ProgressBarStyle}"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressIsIndeterminate}" />

                    <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource MutedText}"
                               FontSize="11.5" Margin="0,8,0,0"
                               Visibility="{Binding ProgressDetail, Converter={StaticResource EmptyVis}}" />
                </StackPanel>

                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,16,0,0"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 6. Resultado de la reparación — dos columnas ===== -->
            <Grid Margin="28,24,28,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=RepairResult}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding ResultTitle}"
                           FontFamily="{StaticResource UiFont}" FontSize="26" FontWeight="Light"
                           Foreground="{StaticResource TextBrush}" Margin="0,4,0,16" />

                <!-- UNA columna. Antes se dividía en «antes y después» + «lo que se hizo»: lo
                     segundo repetía con otras palabras lo que ya decía lo primero. Queda la
                     evidencia —cada condición antes y después— cuando la corrida fue completa, y
                     el resultado del fix cuando fue uno solo. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel MaxWidth="840" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding ChecklistCompareRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}"
                                      Visibility="{Binding HasChecklistCompareRows, Converter={StaticResource BoolVis}}" />

                        <!-- Para una corrida de un solo fix no hay antes/después que mostrar:
                             el resultado del fix ES el resultado de la pantalla. -->
                        <ItemsControl ItemsSource="{Binding RepairRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}"
                                      Visibility="{Binding HasChecklistCompareRows, Converter={StaticResource InvertVis}}" />

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                   FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}" />

                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="Hace falta reiniciar para que los cambios tengan efecto."
                                   Visibility="{Binding RebootRequired, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <!-- Si la corrida se abortó (típico: no se pudo crear el punto de
                         restauración), la salida vive ACÁ, donde está el error. Antes la casilla
                         existía solo en la pantalla de Reporte, así que entrando por «Buscar
                         controladores» el mensaje mandaba a marcar algo invisible. -->
                    <Border Style="{StaticResource StatusPanel}" Margin="0,0,0,10"
                            BorderBrush="{StaticResource WarningBrush}"
                            Visibility="{Binding LastRunAborted, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource LabeledCheckBox}"
                                      IsChecked="{Binding AllowWithoutRestorePoint, Mode=TwoWay}">
                                <TextBlock Text="Continuar aunque no se pueda crear el punto de restauración"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="25,6,0,0"
                                       Text="Cada cambio queda registrado igual, así que «Deshacer todo» sigue funcionando. Lo que se pierde es el respaldo del sistema completo." />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Volver al inicio" Command="{Binding BackCommand}"
                                Style="{StaticResource GhostButton}" />
                        <Button Content="Reintentar" Command="{Binding RetryLastRunCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Visibility="{Binding LastRunAborted, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ===== 7. Deshacer ===== -->
            <Grid Margin="28,24,28,24"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Undo}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="840" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Margin="0,4,0,10">
                    <TextBlock Text="Deshacer la última reparación"
                               Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0"
                               Text="Esto es lo que se va a revertir. Deshacer también modifica el equipo, así que revisá la lista antes de aplicarlo." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding UndoRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}" />

                        <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}"
                                   FontSize="11.5" Margin="0,14,0,0"
                                   Visibility="{Binding ProgressLabel, Converter={StaticResource EmptyVis}}" />

                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProgressStep}"
                                           Style="{StaticResource MutedText}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource ProgressPercentText}"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                                           Visibility="{Binding ProgressIsIndeterminate, Converter={StaticResource InvertVis}}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource ProgressBarStyle}"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding ProgressIsIndeterminate}" />
                        </StackPanel>

                        <Border Style="{StaticResource StatusPanel}"
                                Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                       FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Volver" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}" Width="100"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                    <Button Content="Deshacer todo" Command="{Binding UndoCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            </Grid>

        </Grid>
    </Border>
</Window>
