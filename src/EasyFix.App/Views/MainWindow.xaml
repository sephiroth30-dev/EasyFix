<Window x:Class="EasyFix.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyFix.App.ViewModels"
        Title="EasyFix"
        Height="560" Width="440"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barra de título propia: arrastrable, sin el chrome de Windows. -->
            <Grid Grid.Row="0" Height="40" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="EasyFix" Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource TitleText}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource ChromeButton}" Click="Minimize_Click"
                            ToolTip="Minimizar" />
                    <Button Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click"
                            ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- Resumen del equipo -->
            <TextBlock Grid.Row="1" Margin="20,8,20,28"
                       Text="{Binding SystemSummary}"
                       Style="{StaticResource MutedText}" />

            <!-- Las tres acciones -->
            <StackPanel Grid.Row="2" Margin="20,0">

                <Button Style="{StaticResource ActionButton}" Command="{Binding ImproveCommand}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Mejorar rendimiento" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Limpia temporales y quita programas del inicio. Crea un punto de restauración antes."
                                   Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButton}" Command="{Binding RepairCommand}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Reparar errores" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Revisa y repara archivos del sistema, disco y red. Puede tardar hasta una hora."
                                   Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ActionButton}" Command="{Binding InstallAppsCommand}">
                    <StackPanel>
                        <TextBlock Text="Instalar programas" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Chrome, Acrobat Reader, 7-Zip y los redistribuibles de Visual C++."
                                   Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Estado. Oculto mientras no haya mensaje; borde de advertencia cuando corresponde. -->
            <Border Grid.Row="3" Margin="20,20" Padding="14,12"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" FontSize="12" />
            </Border>

        </Grid>
    </Border>
</Window>
