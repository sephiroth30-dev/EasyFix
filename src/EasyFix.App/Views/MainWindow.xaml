<Window x:Class="EasyFix.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyFix.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="EasyFix"
        Height="620" Width="460"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <vm:ScreenToVisibilityConverter x:Key="ScreenVis" />
        <vm:EmptyToCollapsedConverter x:Key="EmptyVis" />
        <vm:InverseBooleanConverter x:Key="Invert" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- Una fila del reporte: franja de color + título + detalle + números medidos. -->
        <DataTemplate x:Key="ReportRowTemplate" DataType="{x:Type vm:ReportRow}">
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="11" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="2" Margin="0,11,0,11">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="crit">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="warn">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="2" Margin="0,10,0,11">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                               FontSize="11.5" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Metrics}" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding Metrics, Converter={StaticResource EmptyVis}}" />
                </StackPanel>

                <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>

        <!-- Un programa de la lista: casilla, nombre, nota y estado. -->
        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type vm:AppChoice}">
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="11" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Style="{StaticResource AppCheckBox}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Margin="0,11,0,0" />

                <StackPanel Grid.Column="2" Margin="0,9,0,10">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}"
                               FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding Note, Converter={StaticResource EmptyVis}}" />
                    <!-- El motivo del fallo, con su código. Sin esto, "Falló" no sirve de nada. -->
                    <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap"
                               FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource DangerBrush}"
                               Visibility="{Binding StatusDetail, Converter={StaticResource EmptyVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding Status}" FontFamily="Consolas"
                           FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"
                           Visibility="{Binding Status, Converter={StaticResource EmptyVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="crit">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Barra de título propia ===== -->
            <Grid Grid.Row="0" Height="40" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductName}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{Binding Attribution}" Style="{StaticResource MutedText}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"
                               Visibility="{Binding Attribution, Converter={StaticResource EmptyVis}}" />
                    <!-- La versión va a la vista: un reporte de error sin versión no se puede atar
                         a ningún build. -->
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center" Margin="8,2,0,0"
                               Foreground="{StaticResource TextMutedBrush}" Opacity="0.7" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource ChromeButton}" Click="Minimize_Click"
                            ToolTip="Minimizar" />
                    <Button Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click"
                            ToolTip="Cerrar" />
                </StackPanel>
            </Grid>

            <!-- ===== 1. Inicio ===== -->
            <Grid Grid.Row="1" Margin="20,4,20,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Home}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SystemSummary}"
                           Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,4,0,24" />

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource ActionButton}" Command="{Binding AnalyzeCommand}"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Analizar el equipo" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Solo lectura: mide el equipo y dice qué conviene hacer. No modifica nada."
                                       Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}" Command="{Binding RepairCommand}"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Reparar errores" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Revisa y repara archivos del sistema, disco y red. Puede tardar hasta una hora."
                                       Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}" Command="{Binding InstallAppsCommand}"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Instalar programas" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="Chrome, Acrobat Reader, 7-Zip y los redistribuibles de Visual C++."
                                       Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Solo aparece si hay una corrida anterior con cambios reversibles. Los
                         journals viven en %ProgramData%, así que esto funciona entre sesiones:
                         se puede volver al equipo la semana siguiente y revertir. -->
                    <Button Style="{StaticResource ActionButton}" Command="{Binding OpenUndoCommand}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Deshacer la última reparación" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="{Binding UndoSummary}"
                                       Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource StatusPanel}" VerticalAlignment="Bottom"
                        Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" FontSize="11.5" />
                </Border>
            </Grid>

            <!-- ===== 2. Analizando ===== -->
            <StackPanel Grid.Row="1" Margin="20,4,20,20" VerticalAlignment="Top"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Scanning}">
                <TextBlock Text="Analizando el equipo…" Style="{StaticResource TitleText}"
                           FontSize="15" Margin="0,4,0,4" />
                <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}"
                           FontSize="12.5" Margin="0,0,0,16" />

                <ProgressBar IsIndeterminate="True" Height="3" Background="{StaticResource BorderBrush}"
                             Foreground="{StaticResource AccentBrush}" BorderThickness="0" />

                <Border Style="{StaticResource StatusPanel}" Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5"
                               Text="Todas las comprobaciones son de solo lectura. Cada una tiene su propio límite de tiempo: si alguna se cuelga, se marca «no se pudo determinar» y el reporte sale igual." />
                </Border>

                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,16,0,0" />
            </StackPanel>

            <!-- ===== 3. Reporte ===== -->
            <Grid Grid.Row="1" Margin="20,4,20,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Report}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SystemSummary}"
                           Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,14" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="LO QUE PUEDO ARREGLAR" Style="{StaticResource SectionHeader}"
                                   Visibility="{Binding HasSoftwareRows, Converter={StaticResource BoolVis}}" />
                        <ItemsControl ItemsSource="{Binding SoftwareRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}" />

                        <TextBlock Text="LO QUE NECESITA HARDWARE" Style="{StaticResource SectionHeader}"
                                   Visibility="{Binding HasHardwareRows, Converter={StaticResource BoolVis}}" />
                        <ItemsControl ItemsSource="{Binding HardwareRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}" />

                        <TextBlock Text="NO SE PUDO DETERMINAR" Style="{StaticResource SectionHeader}"
                                   Visibility="{Binding HasUndeterminedRows, Converter={StaticResource BoolVis}}" />
                        <ItemsControl ItemsSource="{Binding UndeterminedRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}" />

                        <Border Style="{StaticResource StatusPanel}"
                                Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                       FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <!-- La confirmación de BitLocker solo aparece si el equipo lo tiene activo.
                         Sin marcarla, las reparaciones que tocan arranque o disco quedan
                         bloqueadas: es la única consecuencia irreversible que puede causar la
                         herramienta. -->
                    <Border Style="{StaticResource StatusPanel}" Margin="0,0,0,10"
                            BorderBrush="{StaticResource DangerBrush}"
                            Visibility="{Binding BitLockerActive, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Este equipo tiene BitLocker" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,8"
                                       Text="Reparar el disco o la red puede hacer que Windows pida la clave de recuperación de 48 dígitos al reiniciar. Sin esa clave, el cliente queda fuera de su propio equipo." />
                            <CheckBox Style="{StaticResource LabeledCheckBox}"
                                      IsChecked="{Binding BitLockerKeyConfirmed, Mode=TwoWay}">
                                <TextBlock Text="Confirmo que la clave de recuperación está a mano"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Continuar sin punto de restauración: decisión explícita del técnico, nunca
                         el default. En muchos equipos Restaurar sistema viene deshabilitado y
                         bloquear todo dejaba la herramienta inservible. -->
                    <Border Style="{StaticResource StatusPanel}" Margin="0,0,0,10"
                            BorderBrush="{StaticResource WarningBrush}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource LabeledCheckBox}"
                                      IsChecked="{Binding AllowWithoutRestorePoint, Mode=TwoWay}">
                                <TextBlock Text="Continuar aunque no se pueda crear el punto de restauración"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="10.5" Margin="25,5,0,0"
                                       Text="Cada cambio queda registrado igual, así que «Deshacer todo» sigue funcionando. Lo que se pierde es el respaldo del sistema completo." />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Volver" Command="{Binding BackCommand}"
                                Style="{StaticResource GhostButton}" Width="100" />
                        <Button Content="Reparar el equipo" Command="{Binding RepairCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding FixesBlocked, Converter={StaticResource Invert}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ===== 4. Instalar programas ===== -->
            <Grid Grid.Row="1" Margin="20,4,20,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Apps}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,4,0,10">
                    <TextBlock Text="Instalar programas" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0"
                               Text="Se descargan del repositorio oficial de Microsoft en el momento, así que siempre entra la última versión. El equipo necesita internet." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Apps}"
                                      ItemTemplate="{StaticResource AppRowTemplate}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />

                        <TextBlock Text="{Binding InstallProgressLabel}" Style="{StaticResource MutedText}"
                                   FontSize="11.5" Margin="0,14,0,0"
                                   Visibility="{Binding InstallProgressLabel, Converter={StaticResource EmptyVis}}" />

                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                     Background="{StaticResource BorderBrush}"
                                     Foreground="{StaticResource AccentBrush}" BorderThickness="0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />

                        <Border Style="{StaticResource StatusPanel}"
                                Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                       FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Volver" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}" Width="80"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                    <Button Content="Diagnosticar winget" Command="{Binding DiagnoseWingetCommand}"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            ToolTip="Muestra dónde está winget, su versión y si puede leer su catálogo." />
                    <Button Content="Instalar" Command="{Binding RunInstallCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ===== 5. Reparando ===== -->
            <StackPanel Grid.Row="1" Margin="20,4,20,20" VerticalAlignment="Top"
                        Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Repairing}">
                <TextBlock Text="Reparando el equipo…" Style="{StaticResource TitleText}"
                           FontSize="15" Margin="0,4,0,4" />
                <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}"
                           FontSize="12.5" Margin="0,0,0,16" />

                <ProgressBar IsIndeterminate="True" Height="3" Background="{StaticResource BorderBrush}"
                             Foreground="{StaticResource AccentBrush}" BorderThickness="0" />

                <Border Style="{StaticResource StatusPanel}">
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5"
                               Text="Se creó un punto de restauración antes del primer cambio. Cada acción queda registrada antes de aplicarse, así que se puede deshacer incluso si esto se interrumpe. Reparar los archivos del sistema puede tardar 40 minutos." />
                </Border>

                <Button Content="Cancelar" Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,16,0,0" />
            </StackPanel>

            <!-- ===== 6. Resultado de la reparación ===== -->
            <Grid Grid.Row="1" Margin="20,4,20,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=RepairResult}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Resultado de la reparación"
                           Style="{StaticResource TitleText}" FontSize="15" Margin="0,4,0,10" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding RepairRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}" />

                        <Border Style="{StaticResource StatusPanel}"
                                Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                       FontSize="11.5" />
                        </Border>

                        <Border Style="{StaticResource StatusPanel}"
                                BorderBrush="{StaticResource WarningBrush}"
                                Visibility="{Binding RebootRequired, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5"
                                       Text="Hay cambios que necesitan reinicio para tener efecto. Reiniciá el equipo y volvé a analizar: el tiempo de arranque se compara contra el valor de antes." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2" Content="Volver al inicio" Command="{Binding BackCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,14,0,0" />
            </Grid>

            <!-- ===== 7. Deshacer ===== -->
            <Grid Grid.Row="1" Margin="20,4,20,20"
                  Visibility="{Binding CurrentScreen, Converter={StaticResource ScreenVis}, ConverterParameter=Undo}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,4,0,10">
                    <TextBlock Text="Deshacer la última reparación"
                               Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0"
                               Text="Esto es lo que se va a revertir. Deshacer también modifica el equipo, así que revisá la lista antes de aplicarlo." />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding UndoRows}"
                                      ItemTemplate="{StaticResource ReportRowTemplate}" />

                        <TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource MutedText}"
                                   FontSize="11.5" Margin="0,14,0,0"
                                   Visibility="{Binding ProgressLabel, Converter={StaticResource EmptyVis}}" />

                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                     Background="{StaticResource BorderBrush}"
                                     Foreground="{StaticResource AccentBrush}" BorderThickness="0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />

                        <Border Style="{StaticResource StatusPanel}"
                                Visibility="{Binding StatusMessage, Converter={StaticResource EmptyVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                                       FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Volver" Command="{Binding BackCommand}"
                            Style="{StaticResource GhostButton}" Width="100"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}" />
                    <Button Content="Deshacer todo" Command="{Binding UndoCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
