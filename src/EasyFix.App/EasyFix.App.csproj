<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <AssemblyName>EasyFix</AssemblyName>
    <RootNamespace>EasyFix.App</RootNamespace>

    <!-- La versión y la marca vienen de Directory.Build.props: fuente única. -->
    <AssemblyTitle>EasyFix — Diagnóstico y reparación de Windows</AssemblyTitle>
    <Description>Herramienta de técnico: diagnostica, repara e instala software base en equipos Windows.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Permite COMPILAR el proyecto WPF desde macOS/Linux: el SDK baja el reference pack de
         Microsoft.WindowsDesktop.App en vez de exigir un Windows. El XAML se compila y se valida
         igual. Lo que NO se puede es ejecutar el .exe fuera de Windows.
         Con esto el desarrollo de la UI no queda bloqueado esperando una VM; la VM sigue siendo
         imprescindible para probar los fixes, que es otra cosa. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- .exe único y portable para el USB: no hay que instalar runtime en el equipo del cliente. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Sin trimming: recorta por análisis estático y rompe todo lo que usa reflexión —
         System.Management (WMI), el binder de System.Text.Json y los generadores de MVVM.
         El .exe pesa más, pero funciona. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Comprime el runtime embebido: baja el .exe casi a la mitad a cambio de unas décimas de
         segundo en el primer arranque. Para un archivo que viaja en un pendrive, conviene. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- El .pdb queda aparte y no se copia al pendrive: al .exe le alcanza consigo mismo. -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyFix.Core\EasyFix.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Puente Serilog -> ILogger<T>: Core depende solo de la abstracción, no de Serilog. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json va embebido: el .exe tiene que funcionar solo, desde el USB. -->
    <EmbeddedResource Include="..\..\appsettings.json" LogicalName="EasyFix.appsettings.json" />
  </ItemGroup>

</Project>
