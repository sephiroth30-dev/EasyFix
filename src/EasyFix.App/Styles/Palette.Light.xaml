<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta CLARA. Define exactamente las mismas claves que Palette.Dark.xaml: todos los
        estilos de Theme.xaml las consumen por nombre, así que cambiar de tema es cambiar este
        diccionario y nada más.

        Los colores no son los oscuros «invertidos»: en fondo claro el texto gris de los oscuros
        queda ilegible, y los acentos saturados vibran. Se eligieron con contraste suficiente
        sobre blanco (el texto principal y el atenuado superan 4.5:1 sobre el fondo, que es el
        mínimo de WCAG AA para texto normal).
    -->

    <Color x:Key="BackgroundColor">#FFF6F7F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#FFEDEFF3</Color>
    <Color x:Key="BorderColor">#FFD4D8E0</Color>
    <Color x:Key="TextColor">#FF13161B</Color>
    <Color x:Key="TextMutedColor">#FF5B6472</Color>

    <!-- Más oscuro que el acento del tema oscuro: #4C9AFF sobre blanco no llega a contraste de
         texto. Este sí, y sigue siendo el mismo azul de la marca. -->
    <Color x:Key="AccentColor">#FF1A68D1</Color>

    <Color x:Key="DangerColor">#FFC42B2B</Color>
    <Color x:Key="WarningColor">#FF8A5A00</Color>
    <Color x:Key="OkColor">#FF1C7A46</Color>

    <SolidColorBrush x:Key="BackgroundBrush"   Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush"         Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"    Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush"      Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="OkBrush"           Color="{StaticResource OkColor}" />

    <!--
        Texto que va ENCIMA del color de acento (el botón principal). En el tema oscuro es casi
        negro porque el acento es claro; acá el acento es oscuro, así que tiene que ser blanco.
        Sin esta clave, el botón principal quedaría con texto negro sobre azul oscuro.
    -->
    <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />

</ResourceDictionary>
