<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows y no net8.0: System.Management y todo el acceso a WMI/registro son
         Windows-only. Declararlo explícito evita advertencias CA1416 en cada llamada. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Nullability, analizadores e ImplicitUsings vienen de Directory.Build.props. -->

    <!-- Este proyecto NO debe referenciar WPF. Se verifica con un test de arquitectura. -->
    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Superficie de NuGet deliberadamente mínima: solo APIs estables y muy conocidas.
         La configuración se lee con System.Text.Json (BCL) en vez de
         Microsoft.Extensions.Configuration, y el árbol de archivos usa un puerto propio de 9
         métodos (IFileTree) en vez de System.IO.Abstractions. Motivo: sin compilador disponible,
         cada dependencia extra es API que no puedo verificar. Es una desviación consciente del
         plan; revisable cuando exista la VM. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
